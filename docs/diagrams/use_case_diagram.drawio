        <mxCell id="dep_cust_layanan" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="uc_cust_pesan" target="uc_cust_layanan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 9. Melakukan Pemesanan -> include -> Hitung Ongkos Kirim Otomatis -->
        <mxCell id="dep_cust_ongkir" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="uc_cust_pesan" target="uc_cust_ongkir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 10. Melakukan Pembayaran -> include -> Unggah Bukti Transaksi -->
        <mxCell id="dep_cust_bukti" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="uc_cust_bayar" target="uc_cust_bukti">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 11. Melacak Pengiriman -> extend -> Melihat Riwayat Pesanan -->
        <mxCell id="dep_cust_lacak" value="&lt;&lt;extend&gt;&gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="uc_cust_lacak" target="uc_cust_riwayat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 12. Lihat Total Pendapatan -> include -> Pendapatan Harian / Mingguan / Bulanan -->
        <mxCell id="dep_owner_pend" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="uc_owner_total_rev" target="uc_owner_pend_split">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
