<mxfile host="app.diagrams.net" modified="2026-08-31T20:15:00.000Z" agent="Mozilla/5.0" version="24.0.0" type="device">
  <diagram id="workflow_manual_terpadu" name="WorkFlow Sistem Sedang Berjalan">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" pageOrientation="landscape" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Swimlanes / Header Boxes -->
        <mxCell id="lane_owner" value="Pemilik (Owner)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Times New Roman;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="340" height="1020" as="geometry" />
        </mxCell>
        
        <mxCell id="lane_admin" value="Kasir / Admin" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;fontFamily=Times New Roman;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="380" height="1020" as="geometry" />
        </mxCell>
        
        <mxCell id="lane_pelanggan" value="Pelanggan (Customer)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;fontFamily=Times New Roman;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="360" height="1020" as="geometry" />
        </mxCell>

        <!-- Phase 1: Manajemen Bahan Baku & Menu (Owner) -->
        <mxCell id="n_start" value="Mulai Operasional" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="lane_owner">
          <mxGeometry x="90" y="45" width="160" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="n_cek_stok" value="1. Pengecekan Fisik Stok Dapur&#xa;(Pemeriksaan visual kacang, sayuran, tauge, lontong, bumbu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_owner">
          <mxGeometry x="40" y="110" width="260" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="n_dec_stok" value="Apakah Ada Bahan&#xa;Habis / Menipis?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffcc;strokeColor=#d6b656;fontSize=10;fontFamily=Times New Roman;fontStyle=1;" vertex="1" parent="lane_owner">
          <mxGeometry x="80" y="185" width="180" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="n_belanja" value="2. Catat Kertas Memo &amp; Belanja&#xa;(Membeli bahan baku fisik di pasar lokal/pemasok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_owner">
          <mxGeometry x="40" y="270" width="260" height="45" as="geometry" />
        </mxCell>
        
        <mxCell id="n_update_menu" value="3. Manajemen Menu &amp; Harga&#xa;(Pembaruan harga/menu fisik di papan tulis / kertas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_owner">
          <mxGeometry x="40" y="335" width="260" height="45" as="geometry" />
        </mxCell>
        
        <mxCell id="n_info_lisan" value="4. Informasi Lisan Ketersediaan &amp; Harga&#xa;(Menyampaikan info stok &amp; harga secara lisan ke Kasir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_owner">
          <mxGeometry x="40" y="400" width="260" height="45" as="geometry" />
        </mxCell>

        <!-- Phase 2: Pemesanan & Kasir (Pelanggan & Admin) -->
        <mxCell id="n_pesan_pelanggan" value="5. Pemesanan Menu&#xa;(Dine-in/Takeaway di warung atau via Chat WA untuk Delivery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_pelanggan">
          <mxGeometry x="50" y="400" width="260" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="n_catat_nota" value="6. Pencatatan Nota Kertas Manual&#xa;(Mencatat porsi hidangan, topping, level pedas, &amp; alamat delivery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_admin">
          <mxGeometry x="60" y="475" width="260" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="n_masak" value="7. Penyiapan Pesanan di Dapur&#xa;(Juru masak menyiapkan gado-gado/karedok/ketoprak)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_admin">
          <mxGeometry x="60" y="545" width="260" height="45" as="geometry" />
        </mxCell>

        <!-- Phase 3: Pembayaran -->
        <mxCell id="n_hitung_kalkulator" value="8. Penghitungan Total dengan Kalkulator Fisik&#xa;(Menghitung total tagihan &amp; uang kembalian secara manual)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_admin">
          <mxGeometry x="60" y="610" width="260" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="n_bayar" value="9. Pembayaran Tunai / Transfer Manual&#xa;(Membayar uang tunai atau menunjukkan bukti transfer fisik/HP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_pelanggan">
          <mxGeometry x="50" y="610" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n_serah_nota" value="10. Penyerahan Nota Pembayaran Manual&#xa;(Memberikan sobekan nota kertas fisik &amp; uang kembalian)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_admin">
          <mxGeometry x="60" y="680" width="260" height="45" as="geometry" />
        </mxCell>

        <!-- Phase 4: Pengiriman (Delivery) -->
        <mxCell id="n_dec_kirim" value="Apakah Jenis Pesanan&#xa;Pesan Antar (Delivery)?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffcc;strokeColor=#82b366;fontSize=10;fontFamily=Times New Roman;fontStyle=1;" vertex="1" parent="lane_admin">
          <mxGeometry x="90" y="745" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n_antar" value="11. Pengantaran Manual oleh Kurir Internal&#xa;(Admin mengantar pesanan ke alamat tanpa pelacak digital)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_admin">
          <mxGeometry x="60" y="825" width="260" height="45" as="geometry" />
        </mxCell>

        <mxCell id="n_terima_makanan" value="12. Penerimaan Makanan oleh Pelanggan&#xa;(Pelanggan menerima pesanan &amp; konfirmasi selesai lisan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_pelanggan">
          <mxGeometry x="50" y="825" width="260" height="45" as="geometry" />
        </mxCell>

        <!-- Phase 5: Laporan Penjualan (Tutup Warung) -->
        <mxCell id="n_rekap_nota" value="13. Rekapitulasi Nota Harian ke Buku Kas Manual&#xa;(Mengumpulkan nota, menjumlahkan omzet harian via kalkulator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_admin">
          <mxGeometry x="60" y="895" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n_serah_buku" value="14. Penyerahan Buku Kas &amp; Uang ke Owner&#xa;(Menyerahkan buku pembukuan fisik &amp; uang tunai)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_admin">
          <mxGeometry x="60" y="960" width="260" height="45" as="geometry" />
        </mxCell>

        <mxCell id="n_eval_owner" value="15. Evaluasi Laba Rugi Manual oleh Pemilik&#xa;(Memeriksa buku catatan kas manual untuk estimasi laba)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontFamily=Times New Roman;" vertex="1" parent="lane_owner">
          <mxGeometry x="40" y="960" width="260" height="45" as="geometry" />
        </mxCell>

        <mxCell id="n_end" value="Selesai Operasional" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="lane_owner">
          <mxGeometry x="90" y="1020" width="160" height="40" as="geometry" />
        </mxCell>

