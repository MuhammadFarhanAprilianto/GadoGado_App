  <diagram id="tahapan_penelitian" name="Diagram Alir Tahapan Penelitian">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Mulai" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="334" y="40" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" value="1. Analisis Sistem Sedang Berjalan&#xa;(Identifikasi alur manual warung, nota kertas, dan pencatatan stok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Times New Roman;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="264" y="120" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="2. Analisis Kebutuhan &amp; Pengumpulan Data&#xa;• Wawancara Kualitatif Pemilik Warung&#xa;• Observasi Lapangan &amp; Studi Pustaka&#xa;• Analisis Kesenjangan (GAP Analysis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Times New Roman;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="264" y="210" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="3. Perancangan Sistem (System Design)&#xa;• Pemodelan UML (Use Case, Activity, Sequence, Class)&#xa;• Perancangan Basis Data NoSQL &amp; ERD&#xa;• Desain Arsitektur Clean MVVM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Times New Roman;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="264" y="320" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6" value="4. Desain Antarmuka Pengguna (UI/UX Mockup)&#xa;(Pembuatan prototipe visual interaktif Figma untuk Pelanggan, Kasir, dan Pemilik)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="264" y="430" width="300" height="65" as="geometry" />
        </mxCell>
        <mxCell id="7" value="5. Pembuatan Sistem (Implementation / Coding)&#xa;• Pengembangan Antarmuka Flutter &amp; Dart&#xa;• Integrasi Cloud Firestore &amp; Supabase Storage&#xa;• Implementasi Otomatisasi Stok Resep &amp; Delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Times New Roman;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="264" y="525" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="8" value="6. Pengujian Sistem (Black Box Testing)&#xa;(Pengujian fungsionalitas tombol, kasir POS, self-ordering, dan integrasi stok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="264" y="635" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Apakah Hasil Pengujian&#xa;Sesuai &amp; Bebas Error?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Times New Roman;fontStyle=1;" vertex="1" parent="1">
